{
  "name": "exp",
  "main": "./lib/ignored-main.js",
  "exports": {
    ".": { "import": "./lib/esm.mjs", "require": "./lib/main.js", "default": "./lib/default.js" },
    "./feature": "./lib/features/one.js",
    "./features/*": "./lib/features/*.js",
    "./d/*": "./lib/features/*.js",
    "./features/*.json": "./lib/features/*.json",
    "./features/private/*": null,
    "./array": ["./lib/missing-first.js", "./lib/features/one.js"],
    "./cond": { "node": { "require": "./lib/features/two.js" }, "default": "./lib/features/one.js" },
    "./nullish": null,
    "./dir/": "./lib/features/",
    "./missing": "./lib/does-not-exist.js",
    "./package.json": "./package.json",
    "./abs": "/etc/passwd",
    "./escape": "./../outside.js",
    "./bare": "somewhere"
  }
}
