{
    "compilerOptions": {
        "composite": true,
        "declarationMap": true,
        "sourceMap": true,
        "target": "es2020",
        "lib": ["es2020"],
        "module": "commonjs",
        "moduleResolution": "node10",
        "ignoreDeprecations": "6.0",
        "strict": true,
        "outDir": "lib",
        "rootDir": "src",
        "pretty": false
    },
    "include": ["src"]
}
